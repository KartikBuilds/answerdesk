// Embeds every help-article section with the bundled model and writes an idempotent SQL seed.
// Run: npm run index   (then load supabase/seed/chunks.sql into the database)
import { mkdirSync, writeFileSync } from "node:fs";
import { chunkArticle, loadArticles } from "../src/lib/content.ts";
import { embed } from "../src/lib/embed.ts";

const q = (s: string) => `'${s.replaceAll("'", "''")}'`;

const chunks = loadArticles().flatMap(chunkArticle);
const vectors = await embed(chunks.map((c) => c.content));
const rows = chunks.map((c, i) =>
  `(${q(c.id)}, ${q(c.slug)}, ${q(c.title)}, ${q(c.heading)}, ${q(c.content)}, '[${vectors[i].map((v) => v.toFixed(6)).join(",")}]')`);

mkdirSync("supabase/seed", { recursive: true });
writeFileSync("supabase/seed/chunks.sql", `-- Generated by scripts/build-index.ts. Do not edit by hand.
begin;
delete from public.ad_chunks where id not in (${chunks.map((c) => q(c.id)).join(", ")});
insert into public.ad_chunks (id, slug, title, heading, content, embedding) values
${rows.join(",\n")}
on conflict (id) do update set slug = excluded.slug, title = excluded.title, heading = excluded.heading,
  content = excluded.content, embedding = excluded.embedding;
commit;
`);
console.log(`Indexed ${chunks.length} sections from ${new Set(chunks.map((c) => c.slug)).size} articles`);
